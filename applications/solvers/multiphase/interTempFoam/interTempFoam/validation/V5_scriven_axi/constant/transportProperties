FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Scriven (1959) bubble growth, setup of Tanguy et al. (2014) JCP 264:1-22,
// values as in basilisk.fr/sandbox/ecipriano/run/scrivenproblem.c:
// water/vapour at 373 K, 1 atm. nu = mu/rho; Pr = mu cp/k (Pr only enters
// the base-class default conductivity, not used by the HardtWondra model).
phases (water vapour);

water
{
    transportModel  Newtonian;
    nu              2.943633e-07;   // mu 2.82e-4 / rho 958
    rho             958;
    cp              4216;
    Pr              1.9815;         // 2.82e-4*4216/0.6
}

vapour
{
    transportModel  Newtonian;
    nu              2.084746e-06;   // mu 1.23e-6 / rho 0.59
    rho             0.59;
    cp              2034;
    Pr              0.096225;       // 1.23e-6*2034/0.026
}

sigma           0.001;              // Tanguy et al. (2014)

curvatureModel  heightFunction;
