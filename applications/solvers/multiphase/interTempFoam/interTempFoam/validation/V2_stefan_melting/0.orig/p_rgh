FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;          // 1 atm

boundaryField
{
    leftWall        { type fixedFluxPressure; gradient uniform 0; value uniform 1e5; }
    rightWall       { type fixedFluxPressure; gradient uniform 0; value uniform 1e5; }
    top             { type symmetryPlane; }
    bottom          { type symmetryPlane; }
    frontAndBack    { type empty; }
}


