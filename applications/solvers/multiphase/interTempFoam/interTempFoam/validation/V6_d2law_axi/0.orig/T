FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];
internalField   uniform 393;
boundaryField
{
    bottom          { type symmetryPlane; }
    outlet          { type fixedValue; value uniform 393; }   // T_inf on the outer boundary (analytic Dirichlet)
    #includeEtc "caseDicts/setConstraintTypes"
}
